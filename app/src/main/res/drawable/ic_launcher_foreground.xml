<?xml version="1.0" encoding="utf-8"?>
<!--
  Card holder's icon: two plain payment cards, with no bank or network marks. The front card has
  a chip and card-number dashes. Everything stays inside Android's 66dp safe circle (centre 54,
  radius 33), so no launcher's icon shape cuts it off.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Indigo card behind -->
    <path
        android:pathData="M42,33h34a5,5 0,0 1,5 5v18a5,5 0,0 1,-5 5h-34a5,5 0,0 1,-5 -5v-18a5,5 0,0 1,5 -5z"
        android:fillColor="#FF5D82E8" />
    <!-- Pale front card -->
    <path
        android:pathData="M32,45h34a5,5 0,0 1,5 5v18a5,5 0,0 1,-5 5h-34a5,5 0,0 1,-5 -5v-18a5,5 0,0 1,5 -5z"
        android:fillColor="#FFF3F7FF" />
    <!-- Amber chip -->
    <path
        android:pathData="M32.5,50h7a1.5,1.5 0,0 1,1.5 1.5v5a1.5,1.5 0,0 1,-1.5 1.5h-7a1.5,1.5 0,0 1,-1.5 -1.5v-5a1.5,1.5 0,0 1,1.5 -1.5z"
        android:fillColor="#FFFFB52B" />
    <path
        android:pathData="M34.3,50v8M37.7,50v8M31,54h10"
        android:strokeColor="#FFFFE1A0"
        android:strokeWidth="0.7" />
    <!-- Card number, in four groups -->
    <path
        android:pathData="M32.1,63.6h4.8M40.1,63.6h4.8M48.1,63.6h4.8M56.1,63.6h4.8"
        android:strokeColor="#FF8A9CC4"
        android:strokeLineCap="round"
        android:strokeWidth="2.2" />
    <!-- Cardholder's name -->
    <path
        android:pathData="M32,68.6h10"
        android:strokeColor="#FFC3CEE6"
        android:strokeLineCap="round"
        android:strokeWidth="1.8" />
</vector>
