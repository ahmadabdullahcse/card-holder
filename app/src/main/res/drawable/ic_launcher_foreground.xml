<?xml version="1.0" encoding="utf-8"?>
<!--
  Card holder's icon: two stacked cards, a blue one behind a gold one with a chip, like the
  wallet's stack. Everything stays inside the 66dp circle Android keeps for any icon shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The card behind -->
    <path
        android:pathData="M38,34h38a4,4 0,0 1,4 4v22a4,4 0,0 1,-4 4h-38a4,4 0,0 1,-4 -4v-22a4,4 0,0 1,4 -4z"
        android:fillColor="#FF5B8DEF" />
    <!-- Its shadow on the front card -->
    <path
        android:pathData="M30,45h40a4,4 0,0 1,4 4v1h-48v-1a4,4 0,0 1,4 -4z"
        android:fillColor="#40000000" />
    <!-- The gold card in front -->
    <path android:pathData="M32,44h38a4,4 0,0 1,4 4v22a4,4 0,0 1,-4 4h-38a4,4 0,0 1,-4 -4v-22a4,4 0,0 1,4 -4z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="28"
                android:startY="44"
                android:endX="74"
                android:endY="74">
                <item android:color="#FFF6D57E" android:offset="0" />
                <item android:color="#FFC9952E" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Chip -->
    <path
        android:pathData="M34.5,52h7a1.5,1.5 0,0 1,1.5 1.5v4a1.5,1.5 0,0 1,-1.5 1.5h-7a1.5,1.5 0,0 1,-1.5 -1.5v-4a1.5,1.5 0,0 1,1.5 -1.5z"
        android:fillColor="#FF8A6420" />
    <!-- Card number -->
    <path
        android:pathData="M33,64h7v2.2h-7zM42.5,64h7v2.2h-7zM52,64h7v2.2h-7z"
        android:fillColor="#B35E4314" />
</vector>
