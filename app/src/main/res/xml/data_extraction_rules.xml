<?xml version="1.0" encoding="utf-8"?>
<!-- Saved cards and bills stay on this phone: they are left out of cloud backups and device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="cards.json" />
        <exclude domain="file" path="cards.json.bak" />
        <exclude domain="file" path="cards.json.tmp" />
        <exclude domain="file" path="cards.json.damaged" />
        <exclude domain="file" path="bills.json" />
        <exclude domain="file" path="bills.json.bak" />
        <exclude domain="file" path="bills.json.tmp" />
        <exclude domain="file" path="bills.json.damaged" />
        <exclude domain="file" path="unmatched_bills.json" />
        <exclude domain="file" path="unmatched_bills.json.bak" />
        <exclude domain="file" path="unmatched_bills.json.tmp" />
        <exclude domain="file" path="unmatched_bills.json.damaged" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="cards.json" />
        <exclude domain="file" path="cards.json.bak" />
        <exclude domain="file" path="cards.json.tmp" />
        <exclude domain="file" path="cards.json.damaged" />
        <exclude domain="file" path="bills.json" />
        <exclude domain="file" path="bills.json.bak" />
        <exclude domain="file" path="bills.json.tmp" />
        <exclude domain="file" path="bills.json.damaged" />
        <exclude domain="file" path="unmatched_bills.json" />
        <exclude domain="file" path="unmatched_bills.json.bak" />
        <exclude domain="file" path="unmatched_bills.json.tmp" />
        <exclude domain="file" path="unmatched_bills.json.damaged" />
    </device-transfer>
</data-extraction-rules>
